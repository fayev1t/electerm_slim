.logo-elem
  display flex
  justify-content center
  align-items center
  flex-wrap wrap
  gap 12px
  .logo-img
    width 64px
    height 64px
  .logo-name
    font-size 36px
    letter-spacing -1.5px
    color var(--text)
.is-mobile
  .logo-elem
    margin-top 8px
    margin-bottom 8px
    gap 8px
    .logo-img
      width 36px
      height 36px
    .logo-name
      font-size 24px
