.fullscreen
  .sidebar
  .tabs
  .terminal-control
  .qm-wrap-tooltip
  .remote-monitor-bar
  .session-v-info
    display none
  .tabs.mobile-tabs
    display none
  .session-wrap
    display none
  .session-wrap.session-current
    display block !important
    position fixed
    left 0 !important
    top 0 !important
    padding-top 0 !important
    height 100% !important
    width 100% !important
    .term-wrap
    .session-v-wrap
      position fixed
      left 0 !important
      top 0 !important
      height 100% !important
      width 100% !important
    .term-wrap-1
      left 10px !important
      top 10px !important
      right 10px !important
      bottom 10px !important

// Terminal tools stay at the top in fullscreen as well.
.fullscreen.fs-with-toolbar
  .session-current
    .terminal-control
      display flex
    .remote-monitor-bar
      display flex
    .qm-wrap-tooltip
      display block
    .terminal-footer-show-sidebar
      display none
    .term-wrap
      top calc(32px + var(--session-toolbar-panels-height, 0px)) !important
      height calc(100% - 32px - var(--session-toolbar-panels-height, 0px) - var(--shortcut-bar-h, 0px) - var(--shortcut-bar-kb-offset, 0px)) !important
