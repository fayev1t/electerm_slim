.terminal-tools
  flex 1
  min-width 0
  background var(--main)

.terminal-footer-flex
  display flex
  align-items center
  height 32px
  .terminal-footer-unit .ant-select-selector .ant-select-selection-placeholder
    line-height 24px
.terminal-footer-unit
  flex-shrink 0
  margin-left 8px
  line-height 32px
  textarea.ant-input
    min-height 26px
    height 26px
    resize none

.terminal-footer-center
  flex-grow 1
.terminal-footer-info
  margin-right 2px
.terminal-footer-history
.terminal-footer-triggers
  display flex
  align-items center
.terminal-footer-qm
  margin-left 3px
.batch-input-holder
  width 100px

.batch-input-panel
  display flex
  flex-direction column
  gap 6px
  width 360px
  max-width calc(100vw - 40px)
  textarea.ant-input
    resize none

.batch-tab-item
  display inline-flex
  max-width 100%
  .batch-tab-title
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
