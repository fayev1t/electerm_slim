.terminal-control
  display flex
  align-items center
  height 32px
  overflow-x auto
  overflow-y hidden
  scrollbar-width none
  &::-webkit-scrollbar
    display none
  .term-sftp-tabs
    float none
    flex-shrink 0
    white-space nowrap
  .term-controls
    float none
    display flex
    align-items center
    flex-shrink 0
    margin-left auto
  .terminal-tools
    min-width max-content
.session-controls
  display flex
  align-items center
  flex-shrink 0

// Mobile session control: pane tabs always visible,
// other icons shown in a floating Popover overlay
.mobile-session-control
  background var(--main)
  line-height 32px
  padding 0 10px
  display flex
  align-items center
  // pane tabs take available space, menu icon sits at the end
  .term-sftp-tabs
    float none
    display flex
    align-items center
    flex-shrink 0
.mobile-control-toggle
.mobile-context-menu-toggle
  font-size 16px
  line-height 32px
  color var(--text)
  flex-shrink 0
  &:hover
    color var(--text-light)

// touch-only terminal context menu icon, in the bar next to the toggle above
.mobile-context-menu-toggle
  margin-right 10px

// Popover content — icons laid out in a row, wrapping as needed
.mobile-control-icons
  display flex
  flex-wrap wrap
  align-items center
  gap 4px 8px
  max-width 280px
  line-height 30px
  .term-controls
    float none
    display flex
    align-items center
    margin-left 0
  .sess-icon
    margin-right 0
