# Run from the repository root: cp src/build/.sample.env .env

## test env

## test ssh ip or host, required
TEST_HOST=0.0.0.0

## test ssh username, required
TEST_USER=xxx

## test ssh port, optional, default 22
# TEST_PORT=22

## test ssh password, required
TEST_PASS=xxx

## Optional: set a writable data directory, or leave unset to use the default.
# DATA_PATH=/path/to/electerm_slim-data
