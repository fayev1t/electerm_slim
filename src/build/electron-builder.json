{
  "appId": "io.github.fayev1t.electerm-slim",
  "directories": {
    "app": "work/app",
    "output": "dist",
    "buildResources": "src/assets/branding/build"
  },
  "electronLanguages": [
    "en-US"
  ],
  "asar": true,
  "asarUnpack": [
    "node_modules/node-pty/build/Release/**"
  ],
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "win": {
    "target": [
      "tar.gz",
      "nsis"
    ],
    "icon": "src/assets/branding/build/icon.ico",
    "publish": {
      "provider": "github",
      "channel": "${env.WORKFLOW_NAME}",
      "owner": "fayev1t",
      "repo": "electerm_slim"
    }
  },
  "protocols": [
    {
      "name": "SSH Protocol",
      "schemes": [
        "ssh"
      ]
    },
    {
      "name": "Telnet Protocol",
      "schemes": [
        "telnet"
      ]
    },
    {
      "name": "RDP Protocol",
      "schemes": [
        "rdp"
      ]
    },
    {
      "name": "VNC Protocol",
      "schemes": [
        "vnc"
      ]
    },
    {
      "name": "Serial Protocol",
      "schemes": [
        "serial"
      ]
    },
    {
      "name": "Spice Protocol",
      "schemes": [
        "spice"
      ]
    },
    {
      "name": "electerm_slim Protocol",
      "schemes": [
        "electerm-slim"
      ]
    }
  ],
  "fileAssociations": [
    {
      "ext": "vv",
      "name": "Virt Viewer connection file",
      "description": "SPICE console connection file (virt-viewer / remote-viewer)",
      "mimeType": "application/x-virt-viewer",
      "role": "Viewer"
    }
  ],
  "nsis": {
    "oneClick": false,
    "artifactName": "${productName}-${version}-${os}-${arch}-installer.${ext}",
    "allowToChangeInstallationDirectory": true
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": "dmg",
    "icon": "src/assets/branding/build/icon.icns",
    "publish": {
      "provider": "github",
      "channel": "${env.WORKFLOW_NAME}",
      "owner": "fayev1t",
      "repo": "electerm_slim"
    },
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "./src/build/entitlements.plist",
    "entitlementsInherit": "./src/build/entitlements.plist",
    "notarize": true
  },
  "dmg": {
    "contents": [
      {
        "x": 110,
        "y": 190
      },
      {
        "x": 440,
        "y": 190,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "linux": {
    "category": "Development;System;TerminalEmulator",
    "icon": "src/assets/branding/build/icons",
    "target": [
      "rpm",
      "deb",
      "AppImage",
      "tar.gz",
      "snap"
    ],
    "publish": {
      "provider": "github",
      "channel": "${env.WORKFLOW_NAME}",
      "owner": "fayev1t",
      "repo": "electerm_slim"
    },
    "desktop": {
      "entry": {
        "StartupWMClass": "electerm_slim"
      }
    },
    "executableName": "electerm-slim",
    "maintainer": "fayev1t <fayev1t@users.noreply.github.com>"
  },
  "snap": {
    "confinement": "classic",
    "publish": {
      "provider": "github",
      "channel": "${env.WORKFLOW_NAME}",
      "owner": "fayev1t",
      "repo": "electerm_slim"
    }
  },
  "deb": {
    "afterInstall": "src/build/bin/linux-deb-after-build.sh",
    "packageName": "electerm-slim"
  },
  "productName": "electerm_slim",
  "rpm": {
    "packageName": "electerm-slim"
  }
}
